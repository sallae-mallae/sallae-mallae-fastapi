APP_NAME=살래말래 API
DEBUG=false

# Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Florence-2 모델 (HuggingFace 모델명)
# microsoft/Florence-2-base  (가볍고 빠름)
# microsoft/Florence-2-large (정확도 높음)
FLORENCE_MODEL_ID=microsoft/Florence-2-base

# 이미지 서버 저장 여부 (설정 화면 연동)
SAVE_IMAGES=false

# DB 파일 경로
DATABASE_URL=sqlite+aiosqlite:///./sallae_mallae.db
