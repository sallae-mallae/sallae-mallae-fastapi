APP_NAME=살래말래 API
DEBUG=false

# Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Florence-2 모델
# microsoft/Florence-2-base (빠름) / microsoft/Florence-2-large (정확도 높음)
FLORENCE_MODEL_ID=microsoft/Florence-2-base

# Supabase RAG
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=products
SUPABASE_MATCH_COUNT=5
GROQ_API_KEY=
# 이미지 저장
SAVE_IMAGES=false

# YOLO 모델
YOLO_MODEL=yolo11n.pt

# DB
DATABASE_URL=sqlite+aiosqlite:///./sallae_mallae.db