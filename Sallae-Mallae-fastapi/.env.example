APP_NAME=살래말래 API
DEBUG=false

# Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 모델 (설정 화면 연동)
GEMINI_MODEL=gemini-2.0-flash

# 이미지 서버 저장 여부
SAVE_IMAGES=false

# DB 파일 경로
DATABASE_URL=sqlite+aiosqlite:///./sallae_mallae.db

# YOLO 모델 (라벨링/파인튜닝용)
# yolo11n.pt (6MB, 빠름) / yolo11s.pt / yolo11m.pt (정확도 높음)
YOLO_MODEL=yolo11n.pt
